# Public app origin (HTTPS in production)
APP_URL=http://localhost:3000

# Supabase — public URL/key may be exposed only as anon/public values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY — never prefix these with VITE_
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — SERVER ONLY
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Links de checkout da Cakto (cole aqui as URLs individuais de cada produto)
VITE_CAKTO_EBOOK_URL=
VITE_CAKTO_PROMPTS_URL=

# Mentoria online — campos configuráveis do terceiro produto
# Valores em reais, por exemplo: 297,00
VITE_MENTORIA_PRECO_ORIGINAL=
VITE_MENTORIA_PRECO_PROMOCIONAL=
# URL pública da imagem oficial (ex.: /mentoria-sites-ia.jpg após adicionar o arquivo em public/)
VITE_MENTORIA_IMAGE_URL=/mentoria-criacao-sites-com-ia.png
# Link individual do checkout da mentoria
VITE_CAKTO_MENTORIA_URL=https://pay.cakto.com.br/k48vpwz_1292667
